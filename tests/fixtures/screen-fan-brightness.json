{
  "description": "Screen page: Fan 3 at 60 % brightness (set in this theme): Use default goes back to the screen's own.",
  "base": "screen-fan",
  "screensPatch": [
    {
      "op": "replace",
      "path": "/screens/2/brightness/value",
      "value": 60
    },
    {
      "op": "replace",
      "path": "/screens/2/brightness/effective",
      "value": 60
    }
  ],
  "previewFile": "preview.screens.json",
  "previewPatch": [
    {
      "op": "replace",
      "path": "/screens/roles/screen.fan2/state",
      "value": "ready"
    },
    {
      "op": "replace",
      "path": "/screens/roles/screen.fan2/error",
      "value": null
    },
    {
      "op": "replace",
      "path": "/screens/roles/screen.pump/state",
      "value": "ready"
    },
    {
      "op": "replace",
      "path": "/screens/failed",
      "value": []
    }
  ],
  "ui": {
    "page": "screen",
    "screen": {
      "role": "screen.fan3"
    }
  }
}
