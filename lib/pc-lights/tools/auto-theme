def contact_sheet(keep_a, keep_b, keep_p, banner, out):
    from PIL import Image
    fa = [keep_a[i] for i in sorted(keep_a)]
    fb = [keep_b[i] for i in sorted(keep_b)]
    pw = keep_p[min(keep_p)]
    sheet = Image.new("RGB", (1600, 400 * 2 + pw.size[1] * 2 + 16 + 200 + 16), (20, 20, 20))
    for j, f in enumerate(fa[:4]):
        sheet.paste(f, (j * 400, 0))
    for j, f in enumerate(fb[:4]):
        sheet.paste(f, (j * 400, 400))
    y = 800
    for j, i in enumerate(sorted(keep_p)[:2]):
        sheet.paste(keep_p[i], (j * (pw.size[0] + 16), y))
    y += pw.size[1] + 16
    sheet.paste(banner.resize((800, 200)), (0, y))
    sheet = sheet.crop((0, 0, 1600, y + 200))
    sheet.save(out, quality=85)


def v3_theme(light, c, about):
    """The v3 layout (docs/THEMES.md): a palette plus the same lighting as explicit roles,
    so the look doesn't depend on the engine's palette derivation."""
    roles = {k: v for k, v in light.items() if k != "alert"}
    roles["fans"] = {"inner": light["fans"]["top"], "outer": light["fans"]["bottom"],
                     "_note": "inner = the inner edges of a fan frame, outer = its outer bars"}
    return {
        "v": 3,
        "_about": about,
        "_generator": GENERATOR,
        "palette": {"primary": c["primary"], "secondary": c["secondary"], "accent": c["primary"],
                    "alert": light["alert"]["color"]},
        "motion": {k: light["strimers"][k] for k in ("mode", "speed", "direction")},
        "roles": roles,
        "alert": light["alert"],
    }


def build(slug, src_dir, final, schema=3, media=True, prof=None):
    """Build into a hidden temp dir next to final and swap it in. Caller holds the slug lock."""
    import numpy as np  # noqa: F401 (fail early if missing)
    t0 = time.time()
    clean_stale(slug)
    files, cur_bg = wallpaper_candidates(src_dir, slug)
    fp = fingerprint(src_dir, files)
    colors = os.path.join(src_dir, "colors.toml")
    pal, mode = parse_colors(colors) if os.path.isfile(colors) else ({}, None)
    if not pal:
        log(f"no usable colours in {colors}; using wallpaper colours only")
    if mode not in ("light", "dark"):
        bg = pal.get("background")
        mode = "light" if bg and lum(bg) > 0.4 else "dark"

    im, wall = load_wallpaper(files)
    if im is not None:
        sal, hues, _ = analyse(im)
    else:
        hues = [0.0] * 36
    c = pick_colours(pal, hues, mode == "light")
    if im is None:
        log("no readable wallpaper; synthesising one from the palette")
        im, _ = synth_wallpaper(c)
        sal, hues, _ = analyse(im)

    # hidden names: never listed as a theme, even if a SIGKILL leaves them behind
    tmp = os.path.join(THEMES, f".omarchy-{slug}.tmp-{os.getpid()}")
    shutil.rmtree(tmp, ignore_errors=True)
    for sub in ("media", "us88", "src") if media else ("src",):
        os.makedirs(os.path.join(tmp, sub))
    try:
        regions, grades, tid, banner = [], {}, None, None
        al = ap = 0.0
        ka = {0: None, 72: None, 144: None, 216: None}
        kb = dict(ka)
        kp = {0: None, 144: None}
        text_hex, label_hex = text_colours(pal, c)
        pretty = slug.replace("-", " ").title()
        if media:
            regions = pick_fan_regions(sal, im.size)
            light_mode = mode == "light"
            grades["fan-a"] = render_fan(im, regions[0], os.path.join(tmp, "media/fan-a.mp4"), 0.0, ka, light_mode)
            log(f"fan-a done ({time.time() - t0:.0f} s)")
            grades["fan-b"] = render_fan(im, regions[1], os.path.join(tmp, "media/fan-b.mp4"), math.pi, kb, light_mode)
            log(f"fan-b done ({time.time() - t0:.0f} s)")
            grades["pump"] = render_pump(im, sal, os.path.join(tmp, PUMP_MEDIA), kp, light_mode)
            log(f"pump done ({time.time() - t0:.0f} s)")

            font_dst = os.path.join(tmp, "us88/agencygothicct-condensed.otf")
            if os.path.isfile(FONT_SRC):
                shutil.copyfile(FONT_SRC, font_dst)
            else:
                fb = subprocess.run(["fc-match", "-f", "%{file}", "sans:condensed:bold"],
                                    capture_output=True, text=True).stdout
                if not fb or not os.path.isfile(fb):
                    raise RuntimeError(f"font {FONT_SRC} missing and no fallback found")
                shutil.copyfile(fb, font_dst)
                log(f"font {FONT_SRC} missing; copied {fb} under the same name")

            outline = c["primary"] if not c["mono"] else "8090c0"
            darks = [pal[k] for k in ("darker_background", "dark_background", "background", "black")
                     if k in pal and lum(pal[k]) < 0.05]
            scrim = min(darks, key=lum) if darks else rgb2h(x * 0.10 for x in h2rgb(outline))
            banner, al, ap, grades["us88"] = render_banner(im, sal, os.path.join(tmp, "us88/background.png"),
                                                           scrim, outline, light_mode)
            tid, tpl = template(slug, f"Omarchy {pretty}", text_hex, label_hex)
            with open(os.path.join(tmp, f"us88/{tid}.template.json"), "w") as f:
                json.dump(tpl, f, indent=2, ensure_ascii=False)

        today = subprocess.run(["date", "-I"], capture_output=True, text=True).stdout.strip() or \
            datetime.date.today().isoformat()
        light = lighting(c)
        wall_name = os.path.basename(wall) if wall else "a palette-synthesised nebula (no readable wallpaper)"

        def origin(src, ledhex):
            k, v = src
            return f"{k} #{v} -> {ledhex}" if v else f"{k} -> {ledhex}"
        dimmed = [k for k, g in grades.items() if g["bright"]]
        about = (f"Omarchy {pretty}: generated by auto-theme on {today} from the Omarchy theme "
                 f"'{slug}' ({mode}; {src_dir}). "
                 + (f"LEDs: a cool-white family #{c['primary']} / #{c['secondary']} (no hue in the palette "
                    f"or wallpaper). " if c["mono"] else
                    f"LEDs: primary from {origin(c['prim_src'], c['primary'])}, secondary from "
                    f"{origin(c['sec_src'], c['secondary'])} (hue kept, saturation/value maxed for the LEDs). ")
                 + (f"The fan screens are slow seamless 12 s Ken Burns loops of two detailed "
                    f"regions of {wall_name}, vignetted to black, the pump a slow pan across it"
                    + (f" (bright art, so {', '.join(dimmed)} are toned down: gain/gamma in src/source.json)"
                       if dimmed else "")
                    + ", and the 8.8\" screen a banner crop with smoked scrims under the time, date, "
                    "CPU temp and RAM usage. " if media else
                    "Lighting only: no screen media (this PC has no LCD screens in its profile). ")
                 + f"Rebuilt automatically when the Omarchy theme's colors or "
                 f"wallpapers change (unless theme.json is edited by hand); force with: "
                 f"auto-theme {slug} --force.")
        if schema == 2:
            theme = {"_about": about, "_generator": GENERATOR, **light}
            if media:
                theme["screens"] = v2_screens(prof or {}, tid)
                theme["templates"] = [f"us88/{tid}.template.json"]
        else:
            theme = v3_theme(light, c, about)
            if media:
                theme["screens"] = v3_screens(tid)
                theme["templates"] = [f"us88/{tid}.template.json"]
        with open(os.path.join(tmp, "theme.json"), "w") as f:
            json.dump(theme, f, indent=2)
            f.write("\n")
        with open(os.path.join(tmp, "src/source.json"), "w") as f:
            json.dump({"generator": GENERATOR, "schema": schema, "media": media, "date": today,
                       "omarchy_theme": src_dir, "mode": mode,
                       "wallpaper": wall, "wallpaper_preferred": cur_bg or (files[0] if files else None),
                       "wallpaper_size": list(im.size), "source_fingerprint": fp,
                       "theme_json_sha256": sha256(os.path.join(tmp, "theme.json")),
                       "screen_grade": grades, "palette": pal,
                       "picked": {k: v for k, v in c.items()}, "wallpaper_hue_share": [round(h, 4) for h in hues],
                       "fan_regions_cx_cy_side": [[round(v) for v in r] for r in regions],
                       "banner_scrim_alpha": {"left": round(al, 2), "panel": round(ap, 2)},
                       "text": text_hex, "label": label_hex}, f, indent=2)
        if media:
            contact_sheet(ka, kb, kp, banner, os.path.join(tmp, "src/contact.jpg"))
        if not theme_complete(tmp, media):
            raise RuntimeError("built theme failed its completeness check")
        old = None
        if os.path.exists(final):
            old = os.path.join(THEMES, f".omarchy-{slug}.old-{os.getpid()}")
            os.rename(final, old)
        os.rename(tmp, final)
        if old:
            shutil.rmtree(old, ignore_errors=True)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    log(f"built {final} (v{schema}{'' if media else ', no media'}) in {time.time() - t0:.0f} s")


def on_signal(sig, _frame):
    raise SystemExit(128 + sig)   # so build()'s cleanup of the temp dir runs


def take_lock(slug, wait=True):
    """Per-slug build lock, taken before any wait for a pcl-heavy slot. The file is never
    deleted (deleting a held lock file lets two runs lock different inodes).
    -> fd, or None when wait=False and another run holds it."""
    os.makedirs(THEMES, exist_ok=True)
    fd = os.open(os.path.join(THEMES, f".omarchy-{slug}.lock"), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
    if fd == 9:  # pcl-heavy uses fd 9 for its slot lock
        fd2 = os.dup(fd)
        os.close(fd)
        fd = fd2
    try:  # a second run for the same theme waits here, then re-checks
        fcntl.flock(fd, fcntl.LOCK_EX if wait else fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def main():
    usage = "usage: auto-theme <omarchy-slug> [--force] [--schema 2|3] [--no-media]"
    args, force, no_media = [], False, False
    schema = os.environ.get("PCL_AUTO_THEME_SCHEMA", "3")
    argv = sys.argv[1:]
    while argv:
        a = argv.pop(0)
        if a == "--force":
            force = True
        elif a == "--no-media":
            no_media = True
        elif a == "--schema" and argv:
            schema = argv.pop(0)
        elif a.startswith("--schema="):
            schema = a.split("=", 1)[1]
        else:
            args.append(a)
    if len(args) != 1 or args[0].startswith("-") or schema not in ("2", "3"):
        die(usage, 2)
    schema = int(schema)
    slug = args[0]
    # Screens: made unless asked not to, or the profile says this PC has none. v2 output
    # is keyed by serial, so it needs the profile's screen roles.
    prof = load_profile()
    media = not no_media and (prof is None or bool(screen_roles(prof)))
    if schema == 2 and media and prof is None:
        die("--schema 2 needs the hardware profile for the screen serials; run `pc-lights detect`", 2)
    if not re.fullmatch(r"[A-Za-z0-9._-]+", slug) or slug in (".", ".."):
        die(f"invalid theme slug '{slug}'", 2)
    src_dir = next((os.path.join(d, slug) for d in OMARCHY_DIRS if os.path.isdir(os.path.join(d, slug))), None)
    if not src_dir:
        die(f"Omarchy theme '{slug}' not found in {' or '.join(OMARCHY_DIRS)}")
    final = os.path.join(THEMES, f"omarchy-{slug}")
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)

    inner = os.environ.get("AUTO_THEME_INNER") == "1"
    lockfd = -1
    if inner:  # re-executed under pcl-heavy: the lock came along as an inherited fd
        try:
            lockfd = int(os.environ.get("AUTO_THEME_LOCKFD", "-1"))
            os.fstat(lockfd)
        except (ValueError, OSError):
            lockfd = -1
    if lockfd < 0:
        if not force:
            keep, why = up_to_date(final, src_dir, slug, schema, media)
            if keep:
                log(f"{final}: {why}; skipping")
                if leftovers(slug):  # a killed build's temp dir; tidy it if nobody is building
                    fd = take_lock(slug, wait=False)
                    if fd is not None:
                        clean_stale(slug)
                        os.close(fd)
                return 0
        lockfd = take_lock(slug)
        if not force:
            keep, why = up_to_date(final, src_dir, slug, schema, media)
            if keep:
                log(f"{final}: {why} (another run just built it); skipping")
                return 0
            log(f"{final}: {why}; building")

    if not inner:
        heavy = shutil.which("pcl-heavy") or os.path.join(HOME, ".local/bin/pcl-heavy")
        if not os.access(heavy, os.X_OK):
            die("pcl-heavy not found; refusing to render outside a capped cgroup")
        os.set_inheritable(lockfd, True)
        env = dict(os.environ, AUTO_THEME_INNER="1", AUTO_THEME_LOCKFD=str(lockfd))
        env.setdefault("PCL_HEAVY_WAIT", HEAVY_WAIT)
        os.execve(heavy, [heavy, sys.executable, os.path.abspath(__file__), *sys.argv[1:]], env)

    for tool in ("ffmpeg",) if media else ():
        if not shutil.which(tool):
            die(f"{tool} not found")
    try:
        build(slug, src_dir, final, schema, media, prof)
    except Exception as e:
        die(f"failed to build omarchy-{slug}: {e}")
    finally:
        os.close(lockfd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
